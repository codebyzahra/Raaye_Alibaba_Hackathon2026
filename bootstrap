#!/usr/bin/env bash
# Alibaba Cloud Function Compute — Custom Runtime bootstrap

set -euo pipefail

CODE_DIR="/code"
cd "$CODE_DIR"

# Use pre-installed dependencies bundled in .fc-deps/
export PYTHONPATH="/code/.fc-deps:${PYTHONPATH:-}"

PYTHON="${PYTHON:-$(command -v python3 || command -v python || echo python3)}"

echo "[bootstrap] Starting Raaye API on port 9000 ..."
exec "$PYTHON" -m uvicorn main:app \
  --host 0.0.0.0 \
  --port 9000 \
  --workers 1 \
  --log-level info